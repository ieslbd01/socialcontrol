# Copy to .env for local use. NEVER commit .env. Production values live in GitHub Secrets / host env.
SC_ENV=local
DATABASE_URL=postgresql+psycopg://socialcontrol:socialcontrol@127.0.0.1:5433/socialcontrol
SC_MASTER_KEY=            # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SC_SIGNING_KEY=           # random 32+ chars
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SC_ADMIN_EMAIL=
SC_ADMIN_PASSWORD_HASH=     # python -m socialcontrol.dashboard.auth  (prompts for a password and prints the hash)
MEDIA_DIR=media_store
